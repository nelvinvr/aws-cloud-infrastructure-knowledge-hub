<mxfile host="app.diagrams.net" modified="2026-08-15T04:00:00.000Z" agent="ChatGPT" version="26.0.16" type="device">
  <diagram id="ec2-hello-world" name="Workshop 1 Architecture">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="EC2 Hello World Web Server – Lab Architecture" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="850" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Workshop 1 • Amazon Linux 2023 • Apache HTTP Server" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#5E6C84;" vertex="1" parent="1"><mxGeometry x="52" y="70" width="700" height="30" as="geometry"/></mxCell>

        <mxCell id="browser" value="&lt;b&gt;Internet user&lt;/b&gt;&lt;br&gt;Web browser&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;Requests the public IPv4 address&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#172B4D;strokeWidth=2;fontSize=16;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1"><mxGeometry x="55" y="315" width="210" height="130" as="geometry"/></mxCell>

        <mxCell id="aws" value="AWS Cloud" style="swimlane;html=1;rounded=1;startSize=36;horizontal=1;fillColor=#F7F9FC;strokeColor=#5E6C84;strokeWidth=2;fontSize=16;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="320" y="110" width="1215" height="700" as="geometry"/></mxCell>
        <mxCell id="region" value="Region: US East (N. Virginia)" style="swimlane;html=1;rounded=1;startSize=34;horizontal=1;fillColor=#F2F7FD;strokeColor=#1473E6;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="aws"><mxGeometry x="35" y="65" width="1145" height="580" as="geometry"/></mxCell>
        <mxCell id="vpc" value="Virtual Private Cloud (VPC)" style="swimlane;html=1;rounded=1;startSize=34;horizontal=1;fillColor=#F7FCF8;strokeColor=#2E8540;strokeWidth=2;fontSize=15;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="region"><mxGeometry x="45" y="65" width="1055" height="455" as="geometry"/></mxCell>

        <mxCell id="igw" value="&lt;b&gt;Internet Gateway&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;Connects the VPC to the internet&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#E8F1FB;strokeColor=#1473E6;strokeWidth=2;fontSize=14;align=center;" vertex="1" parent="vpc"><mxGeometry x="35" y="175" width="190" height="105" as="geometry"/></mxCell>

        <mxCell id="subnet" value="Public subnet • Availability Zone us-east-1b" style="swimlane;html=1;rounded=1;startSize=32;horizontal=1;fillColor=#FFFFFF;strokeColor=#29A3A3;strokeWidth=2;dashed=1;fontSize=14;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="vpc"><mxGeometry x="265" y="55" width="745" height="345" as="geometry"/></mxCell>
        <mxCell id="route" value="&lt;b&gt;Route table&lt;/b&gt;&lt;br&gt;0.0.0.0/0 → Internet Gateway&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;Makes the subnet public&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D97706;strokeWidth=2;fontSize=14;align=center;" vertex="1" parent="subnet"><mxGeometry x="30" y="60" width="220" height="105" as="geometry"/></mxCell>
        <mxCell id="sg" value="&lt;b&gt;Security group&lt;/b&gt;&lt;br&gt;Inbound TCP 80 • HTTP&lt;br&gt;Inbound TCP 22 • temporary lab access&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;Stateful instance firewall&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#FDECEC;strokeColor=#C0392B;strokeWidth=2;fontSize=13;align=center;" vertex="1" parent="subnet"><mxGeometry x="280" y="75" width="220" height="145" as="geometry"/></mxCell>
        <mxCell id="ec2" value="&lt;b&gt;Amazon EC2 instance&lt;/b&gt;&lt;br&gt;Amazon Linux 2023 • t2.micro&lt;br&gt;Public + private IPv4 addresses&lt;hr&gt;&lt;b&gt;Apache HTTP Server&lt;/b&gt;&lt;br&gt;Listens on TCP port 80&lt;br&gt;&lt;code&gt;/var/www/html/index.html&lt;/code&gt;&lt;br&gt;&lt;font color=&quot;#2E8540&quot;&gt;Hello World&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E6;strokeColor=#FF9900;strokeWidth=3;fontSize=14;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="subnet"><mxGeometry x="530" y="55" width="190" height="220" as="geometry"/></mxCell>
        <mxCell id="ebs" value="&lt;b&gt;Amazon EBS&lt;/b&gt;&lt;br&gt;8 GiB root volume&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;Persistent block storage&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#EEE8FA;strokeColor=#7B4AB5;strokeWidth=2;fontSize=13;align=center;" vertex="1" parent="subnet"><mxGeometry x="535" y="285" width="180" height="95" as="geometry"/></mxCell>

        <mxCell id="admin" value="&lt;b&gt;Administrator&lt;/b&gt;&lt;br&gt;EC2 Instance Connect&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;Temporary SSH management&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B4AB5;strokeWidth=2;fontSize=14;align=center;" vertex="1" parent="region"><mxGeometry x="85" y="455" width="220" height="90" as="geometry"/></mxCell>

        <mxCell id="http1" value="HTTP request • TCP 80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1473E6;strokeWidth=4;endArrow=block;endFill=1;fontSize=13;fontStyle=1;fontColor=#1473E6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="browser" target="igw"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="http2" value="Forward via route" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1473E6;strokeWidth=4;endArrow=block;endFill=1;fontSize=12;fontColor=#1473E6;labelBackgroundColor=#FFFFFF;" edge="1" parent="vpc" source="igw" target="sg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="http3" value="Allowed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1473E6;strokeWidth=4;endArrow=block;endFill=1;fontSize=12;fontColor=#1473E6;labelBackgroundColor=#FFFFFF;" edge="1" parent="subnet" source="sg" target="ec2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="storage" value="Root device" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7B4AB5;strokeWidth=2;endArrow=none;fontSize=12;fontColor=#5E6C84;labelBackgroundColor=#FFFFFF;" edge="1" parent="subnet" source="ec2" target="ebs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ssh" value="Temporary SSH • TCP 22" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7B4AB5;strokeWidth=2;dashed=1;endArrow=open;endFill=0;fontSize=12;fontColor=#7B4AB5;labelBackgroundColor=#FFFFFF;" edge="1" parent="region" source="admin" target="ec2"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="legend" value="&lt;b&gt;Traffic legend&lt;/b&gt;&amp;nbsp;&amp;nbsp; ━━━ HTTP request/response&amp;nbsp;&amp;nbsp; – – – Administrative SSH" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#172B4D;" vertex="1" parent="aws"><mxGeometry x="60" y="655" width="700" height="30" as="geometry"/></mxCell>
        <mxCell id="note" value="&lt;b&gt;Architecture lesson:&lt;/b&gt; A public IPv4 address alone is not enough. Internet access also requires an Internet Gateway, a route to it, and a security-group rule that permits the requested port." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7ED;strokeColor=#2E8540;strokeWidth=1;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="aws"><mxGeometry x="765" y="645" width="405" height="55" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
